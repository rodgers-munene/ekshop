# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
# Use Session Pooler URL from Supabase if direct connection fails (IPv6 issue)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# JWT signing secret — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# Token lifetimes
ACCESS_TOKEN_EXPIRE_DAYS=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000

# Paystack — the live payment provider for launch
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Transactional email (Resend)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Ekshop <no-reply@ekshop.co.ke>

# Product image storage (AWS S3) — foundation only, uploads will fail with a
# 502 until these are set once AWS account access is available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
# Optional: CDN / custom domain fronting the bucket
AWS_S3_PUBLIC_URL=

# M-Pesa Daraja — the live checkout payment provider. Paystack above is kept
# only for seller subscription billing.
MPESA_CONSUMER_KEY=your_consumer_key_from_dashboard
MPESA_CONSUMER_SECRET=your_consumer_secret_from_dashboard
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
MPESA_ENVIRONMENT=sandbox
# Bare origin only (e.g. https://abcd1234.ngrok-free.app for local sandbox
# testing) — app/services/mpesa.py appends /payments/mpesa/callback itself.
# Must be publicly reachable over HTTPS; Safaricom cannot call back to
# localhost, so local testing needs an ngrok/cloudflared tunnel.
MPESA_CALLBACK_URL=https://your-tunnel-or-domain
# Shared secret Safaricom's callback must echo back as a ?token= query
# param (Daraja callbacks aren't signed, unlike Paystack's webhook, and we
# can't dictate headers on Safaricom's request to us). Generate with:
# openssl rand -hex 32
MPESA_CALLBACK_SECRET=
