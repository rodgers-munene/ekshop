# Copy this file to .env.local and fill in values. Never commit .env.local.

# FastAPI backend base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID. Leave unset to disable analytics entirely
# (dev and preview builds); set it in the production environment only.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
